# Set a key for whichever provider your agents use.
# AgentConfig.provider selects the backend: "deepseek" | "openai" | "anthropic"

DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: web search upgrade. Without this, search_web uses DuckDuckGo,
# which needs no key.
# TAVILY_API_KEY=tvly-your-tavily-api-key-here
